<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Button?>

<StackPane fx:id="rootStackPane" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.javafxtest.HelloController">

    <VBox alignment="CENTER" spacing="10.0">
        <Label fx:id="devModeLabel" visible="false" managed="false" styleClass="devModeLabel" maxWidth="Infinity" />
        <Label fx:id="playerToPlay" text="Black (Player) to move" styleClass="playerToPlay" />
        <HBox alignment="CENTER" spacing="10.0">
            <Button fx:id="pieRuleButton" visible="false" managed="false" />
            <Button fx:id="pieButtonHelp" visible="false" managed="false" styleClass="pieButtonHelp" />
            <Button fx:id="showStratDM" visible="false" styleClass="showStratDM" managed="false" />
        </HBox>
        <Label fx:id="pieRuleActivated" styleClass="pieRuleActivated" visible="false" managed="false" />
        <GridPane fx:id="gameBoard" alignment="CENTER" hgap="0" vgap="0" />
    </VBox>

</StackPane>
