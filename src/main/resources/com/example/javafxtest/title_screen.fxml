<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>

<!--for aligning and fitting to window, alignment without coordinates-->
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.javafxtest.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <!-- buttons on title screen and the title itself-->
    <Label text="Quax Software System" styleClass="title" />
    <Button text="Player vs Bot" onAction="#onButtonClickPVB"/>
    <Button text="Player vs Player" onAction="#onButtonClickPVP"/>
</VBox>
